{
  "name": "@mcp-restrictor/cli",
  "version": "0.1.0",
  "description": "Cross-client MCP tool restriction proxy and setup CLI.",
  "homepage": "https://github.com/sw1tchdev/mcp-restrictor#readme",
  "bugs": {
    "url": "https://github.com/sw1tchdev/mcp-restrictor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sw1tchdev/mcp-restrictor.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mcp-restrictor": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client-adapter": {
      "types": "./dist/client-adapter.d.ts",
      "import": "./dist/client-adapter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mcp-restrictor/policy": "workspace:*",
    "@mcp-restrictor/transports": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "ink": "7.1.1",
    "jsonc-parser": "3.3.1",
    "react": "19.2.4",
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
